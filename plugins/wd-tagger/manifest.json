{
  "name": "wd-tagger",
  "display_name": "WD Eva02 Large Tagger v3",
  "version": "1.0.0",
  "description": "Auto-tags images using the SmilingWolf/wd-eva02-large-tagger-v3 model. Outputs general, character, and rating tags.",
  "author": "LightView",
  "license": "MIT",
  "execution": {
    "type": "cli",
    "command": "{plugin_dir}/.venv/bin/python",
    "args": ["{plugin_dir}/wd_tagger.py"],
    "timeout_seconds": 120,
    "daemon": true
  },
  "capabilities": ["read_image", "network_access"],
  "tag_prefix": "wd",
  "ui": {
    "settings_schema": null,
    "context_menu_items": [
      {
        "label": "Run WD Tagger",
        "action": "tag",
        "icon": null
      }
    ]
  }
}
