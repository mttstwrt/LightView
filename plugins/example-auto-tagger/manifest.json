{
  "name": "example-image-tagger",
  "display_name": "Example Auto-Tagger",
  "version": "1.0.0",
  "description": "Returns an 'example' tag — demonstrates the LightView plugin protocol.",
  "author": "LightView",
  "license": "MIT",
  "execution": {
    "type": "cli",
    "command": "python3",
    "args": ["{plugin_dir}/tagger.py"],
